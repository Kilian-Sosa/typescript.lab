# Public client configuration for an explicitly selected Supabase environment.
# Never put service-role keys, secret keys or OAuth secrets in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# mvp-production does not read this file or any .env.local file, in either app or runner.
# Supply these public inputs explicitly to scripts/build-mvp-production.mjs:
# VERCEL_ENV=production
# VERCEL_TARGET_ENV=production
# VITE_SUPABASE_URL=https://example.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
# Origins are pinned in shared/deployment/production.ts; no origin override is needed.
# Do not set VITE_MVP_PRODUCTION_DEPLOYMENT_ENV: it is a compiler-owned marker.
# Do not set LAB_RUNNER_LOCAL_TEST for Production.
