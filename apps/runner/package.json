{
  "name": "typescript-lab-runner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node --test tests/browser.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.{js,mjs,cjs,ts,vue,css,html,json,yml,yaml}\""
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
